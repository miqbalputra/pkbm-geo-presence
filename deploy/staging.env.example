APP_ENV=staging
APP_PORT=8080
APP_URL=https://staging.example.invalid
FRONTEND_ORIGINS=https://staging.example.invalid
DB_NAME=presensi_pkbm_staging
DB_USER=presensi_pkbm_staging
DB_PASS=replace-with-a-random-password
DB_ROOT_PASS=replace-with-a-different-random-password
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=30
DB_CONN_MAX_IDLE_TIME_MINUTES=5
DB_CONNECT_TIMEOUT=5s
DB_READ_TIMEOUT=10s
DB_WRITE_TIMEOUT=10s
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=true
GOOGLE_CLIENT_ID=staging-google-client-id.apps.googleusercontent.com
TURNSTILE_SITE_KEY=staging-turnstile-site-key
TURNSTILE_SECRET_KEY=staging-turnstile-secret
TURNSTILE_REQUIRED=true
N8N_API_KEY=staging-n8n-api-key
HERMES_API_KEY=staging-hermes-api-key
GOWA_WEBHOOK_URL=
GOWA_USERNAME=
GOWA_PASSWORD=
ALLOW_PRIVATE_WEBHOOK_TARGETS=false
BACKUP_JOB_TIMEOUT=30m
BACKUP_ARTIFACT_TTL=24h
BACKUP_MAX_SIZE_MB=2048
BACKUP_N8N_API_KEY=replace-with-a-dedicated-32-character-backup-key
BACKUP_RESTORE_ENABLED=false
BACKUP_RETENTION_DAYS=30
BACKUP_DUMP_BINARY=mysqldump
BACKUP_RESTORE_BINARY=mysql
